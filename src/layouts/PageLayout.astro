---
import Avatar from '@/components/Avatar.astro';
import Footer from '@/components/layout/Footer.astro';
import Sidebar from '@/components/layout/Sidebar';
import BlurStack from '@/components/ui/blur-stack';
import Layout from './Layout.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: 'website' | 'article';
	canonical?: string;
	noindex?: boolean;
	fullWidth?: boolean;
	articleDate?: Date;
	articleModified?: Date;
	section?: string;
	/** Advertise that this URL serves text/markdown when asked via Accept. */
	markdownAlt?: boolean;
}

const {
	fullWidth = false,
	ogType = 'website',
	ogImage,
	articleDate,
	articleModified,
	section,
	markdownAlt,
	...layoutProps
} = Astro.props;

// The fixed-position <Avatar /> is rendered on every page. On `/` the
// inline copy lives in <Hero> too; the scroll observer in Avatar.astro
// swaps which one is visible. The body class `has-sidebar-avatar` is
// the single source of truth and is set immediately via an inline
// script below to avoid a flash of the wrong state before hydration.
const isHome = Astro.url.pathname === '/';
---

<Layout
	{...layoutProps}
	ogImage={ogImage}
	ogType={ogType}
	articleDate={articleDate}
	articleModified={articleModified}
	section={section}
	{markdownAlt}
>
	{/* Set the sidebar-avatar body class synchronously so the sidebar and
	    avatar render in the correct state on first paint, and patched on
	    `astro:before-swap` so the *new* document's snapshot for view
	    transitions captures the correct avatar visibility — otherwise
	    the fixed avatar would be display:none during the snapshot and the
	    profile-avatar morph would have no target. */}
	<script is:inline define:vars={{ isHome }}>
		(function () {
			const apply = (body, home) => {
				if (!body) return;
				if (home) body.classList.remove('has-sidebar-avatar');
				else body.classList.add('has-sidebar-avatar');
			};
			apply(document.body, isHome);
			document.addEventListener('astro:before-swap', (e) => {
				const newDoc = e.newDocument;
				const dest = e.to;
				const home = (dest && dest.pathname) === '/';
				apply(document.body, home);
				if (newDoc) apply(newDoc.body, home);
			});
		})();
	</script>

	{/* Explicit `transition:persist="sidebar"` name — auto-generated keys are
	    position-based and shift when adjacent islands change between pages
	    (e.g. /projects → /projects/[slug]), which would silently remount the
	    sidebar and re-trigger its Framer Motion entrance animation.
	    `transition:persist-props` freezes props so React doesn't re-render
	    when Astro hands new pathname/section in from the next page. */}
	<Sidebar
		pathname={Astro.url.pathname}
		section={section}
		client:load
		transition:persist="sidebar"
		transition:persist-props
	/>
	<Avatar />
	<main id="page-content" class="flex-1 pt-[72px] min-[960px]:pt-[60px]">
		{fullWidth ? (
			<slot />
		) : (
			<div class="page-container bg-[var(--background)]">
				<slot />
			</div>
		)}
		{/* Progressive bottom blur lives INSIDE #page-content so its backdrop-filter is
		    captured in the page's crossfade snapshot during navigation (a body-level
		    backdrop-filter can't sample the view-transition top layer, so it would go blank).
		    No opaque background needed: #page-content's view-transition-name is gated to
		    nav-time (html.vt-nav), so at rest it's an ordinary layer and the blur samples the
		    composited page exactly like the body-level original. During nav the snapshot is
		    transparent, so it doesn't cover the live sidebar (no sidebar flash). Static, no
		    persist — it rides the page swap. */}
		<BlurStack
			id="blur-stack"
			className="fixed bottom-0 left-0 right-0 h-32 z-10 pointer-events-none"
		/>
	</main>
	<Footer />
</Layout>
