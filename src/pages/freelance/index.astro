---
import { HugeiconsIcon, InformationCircleIcon } from '@icons';
import FreelanceWork from '@/components/freelance/FreelanceWork.tsx';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout title="Freelance" description="Freelance web and mobile development services.">
  <div class="pb-16">

    <!-- Hero -->
    <section class="pb-10">
      <h1 class="text-heading-1 mb-4 animate-fade-in stagger-2">
        Building products<br/>people actually use.
      </h1>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-5 animate-fade-in stagger-3">
        I work with founders and teams to design and ship digital products.
      </p>

      <!-- Notice -->
      <div class="flex items-start gap-2.5 px-3 py-2.5 rounded-lg bg-[var(--muted-bg)]">
        <HugeiconsIcon icon={InformationCircleIcon} size={13} color="var(--text-ghost)" className="shrink-0 mt-px opacity-50" />
        <p class="text-[12px] text-[var(--text-muted)] leading-relaxed">
          I'm not actively taking freelance work right now. Fully focused on building my startup.
          This page documents past client work.
        </p>
      </div>
    </section>

    <!-- Work -->
    <section class="pb-10">
      <FreelanceWork client:visible />
    </section>

  </div>
</PageLayout>
