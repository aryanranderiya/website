---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { mdxComponents } from '@/components/blog/mdx';
import NewsletterSignup from '@/components/blog/NewsletterSignup.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import ShareButtons from '@/components/blog/ShareButtons.astro';
import PostNav from '@/components/ui/PostNav.astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import { slugOf } from '@/utils/content';

export async function getStaticPaths() {
	// Related + neighbors are computed once per post here: a top-level
	// getCollection per page would re-parse the whole blog on every page.
	// NOTE: everything used here must be inline or imported — Astro hoists
	// getStaticPaths above sibling frontmatter declarations, so local
	// helpers are invisible to it (relatedFor is not defined at path time).
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => {
		const currentTags = new Set(post.data.tags);
		const scored: {
			slug: string;
			title: string;
			date: string;
			featured: boolean | undefined;
			score: number;
			ts: number;
		}[] = [];
		for (const p of posts) {
			if (slugOf(p) === slugOf(post)) continue;
			const score = p.data.tags.filter((t) => currentTags.has(t)).length;
			if (score <= 0) continue;
			scored.push({
				slug: slugOf(p),
				title: p.data.title,
				date: p.data.date.toISOString(),
				featured: p.data.featured,
				score,
				ts: p.data.date.valueOf(),
			});
		}
		scored.sort((a, b) => b.score - a.score || b.ts - a.ts);
		const related = scored
			.slice(0, 3)
			.map(({ slug, title, date, featured }) => ({ slug, title, date, featured }));
		const ordered = posts.toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
		const currentIndex = ordered.findIndex((p) => slugOf(p) === slugOf(post));
		const prevPost = ordered[(currentIndex - 1 + ordered.length) % ordered.length];
		const nextPost = ordered[(currentIndex + 1) % ordered.length];
		return {
			params: { slug: slugOf(post) },
			props: {
				post,
				related,
				prev: { slug: slugOf(prevPost), title: prevPost.data.title },
				next: { slug: slugOf(nextPost), title: nextPost.data.title },
			},
		};
	});
}

interface RelatedPost {
	slug: string;
	title: string;
	date: string;
	featured: boolean | undefined;
}

interface Neighbor {
	slug: string;
	title: string;
}

interface Props {
	post: CollectionEntry<'blog'>;
	related: RelatedPost[];
	prev: Neighbor;
	next: Neighbor;
}

const { post, related, prev, next } = Astro.props as Props;
const { Content, headings } = await render(post);

// Posts can tag images into the TOC via `toc` on <Figure>/<ImageGrid>. The TOC
// is then assembled client-side from the DOM, but we need to know at build time
// whether to render the TOC rail at all (some posts have no headings).
const hasTocImages = /\btoc(\s|=|>|\/)/.test(post.body ?? '');
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  cover={post.data.cover}
  headings={headings}
  forceToc={hasTocImages}
  slug={slugOf(post)}
>
  <Content components={mdxComponents} />

  <div class="mt-16 pt-10 border-t border-[var(--border)]">
    <ShareButtons title={post.data.title} url={Astro.url.href} />
    <RelatedPosts posts={related} />
    <!-- <NewsletterSignup /> -->

    <PostNav
      class="mt-10"
      backHref="/blog"
      backLabel="Back to Writings"
      prevHref={`/${prev.slug}`}
      nextHref={`/${next.slug}`}
      prevLabel={prev.title}
      nextLabel={next.title}
    />
  </div>
</BlogLayout>
