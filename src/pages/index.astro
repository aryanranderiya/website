---
import { getCollection } from 'astro:content';
import BlogPreview from '@/components/home/BlogPreview';
import Hero from '@/components/home/Hero.astro';
import MapWidget from '@/components/home/MapWidget';
import Signature from '@/components/home/Signature';
import SocialsGrid from '@/components/home/SocialsGrid';
import SpotifyWidget from '@/components/home/SpotifyWidget';
import PageLayout from '@/layouts/PageLayout.astro';
import { slugOf } from '@/utils/content';

// Rendered per request so middleware can negotiate content type — agents that
// send `Accept: text/markdown` get a clean markdown mirror of this page (see
// src/middleware.ts). All data below is bundled, nothing is fetched live.
export const prerender = false;

// Fetch and sort blog posts by date descending (exclude drafts), then keep
// only the fields <BlogPreview> renders. Passing whole collection entries
// would serialize every post body into the island props baked into the HTML.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
// Featured posts first, then newest — the homepage is a curated shopfront,
// not a changelog.
const latestPosts = allPosts
	.sort(
		(a, b) =>
			Number(b.data.featured ?? false) - Number(a.data.featured ?? false) ||
			new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
	)
	.map((p) => {
		const { date, ...rest } = p.data;

		return {
			slug: slugOf(p),
			date: new Date(date).toISOString(),
			...rest,
		};
	})
	// Bound the per-request payload: BlogPreview renders the first 4, so only
	// 4 serialized island props ship (this page is prerender=false).
	.slice(0, 4);
---

<PageLayout
  title="Home"
  description="Founder, designer, and developer. Currently building GAIA, an AI companion."
  markdownAlt
>
  <!-- Hero -->
  <Hero />

  <!-- astro-doctor-ignore-next-line astro/no-too-many-islands -- curated homepage: 5 single-purpose lazy islands -->
<BlogPreview posts={latestPosts} client:visible />

  <!-- Spotify + Map -->
  <section class="pb-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <SpotifyWidget client:visible />
      <MapWidget client:visible />
    </div>
  </section>

  <!-- Socials -->
  <div class="pb-8">
    <SocialsGrid client:idle />
  </div>

  <Signature client:visible />
</PageLayout>
