---
import Tweet from '@/components/blog/mdx/Tweet.astro';
import type { ChatPlatform } from '@/components/experiments/gaia-ui/chat-demo';
import { ChatDemoInPhone } from '@/components/experiments/gaia-ui/demos';
import { FooterGlow } from '@/components/experiments/gaia-ui/footer-glow';
import '@/components/experiments/gaia-ui/wordmark-font.css';
import HoloCardIsland from '@/components/experiments/HoloCardIsland';
import { DEMO_CARD } from '@/components/experiments/holo-card/demo';
import BackLink from '@/components/ui/BackLink.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { type Experiment, experiments } from '@/data/experiments';
import PageLayout from '@/layouts/PageLayout.astro';

export function getStaticPaths() {
	return experiments.map((exp) => ({ params: { slug: exp.slug }, props: { exp } }));
}

const { exp } = Astro.props as { exp: Experiment };

const CHAT_PLATFORMS: ChatPlatform[] = ['imessage', 'whatsapp', 'slack', 'discord', 'telegram'];
// Render the documented variants live — anchors double as platform ids.
const chatPlatforms = (exp.gaiaUi?.variants.map((v) => v.anchor) ?? []).filter(
	(a): a is ChatPlatform => (CHAT_PLATFORMS as string[]).includes(a)
);
---

<PageLayout title={`${exp.title} - Experiments`} description={exp.description}>
  <BackLink href="/experiments" label="Back to Experiments" class="mb-8" />

  <div class="mb-8 flex items-start justify-between gap-4 animate-fade-in stagger-1">
    <div>
      <h1 class="text-heading-1 mb-2">{exp.title}</h1>
      <p class="max-w-xl text-[15px] text-[var(--text-secondary)] leading-relaxed">{exp.description}</p>
    </div>
    {exp.gaiaUi && (
      <a
        href={exp.gaiaUi.docsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-1 inline-flex w-fit shrink-0 items-center gap-1.5 rounded-xl border border-[var(--border)] px-4 py-2 text-[13px] no-underline transition-colors hover:bg-[var(--muted-bg)]"
      >
        View on GAIA UI →
      </a>
    )}
  </div>

  {/* live, interactive component */}
  {exp.slug === "chat-demo" && (
  <div class="mb-10 flex flex-col items-center gap-10 animate-fade-in stagger-2">
    {chatPlatforms.map((p) => (
      <ChatDemoInPhone platform={p} client:only="react">
        <div slot="fallback" class="h-[300px] w-full max-w-[280px] rounded-[2rem] bg-[var(--muted-bg)] animate-pulse" aria-hidden="true" />
      </ChatDemoInPhone>
    ))}
  </div>
  )}
  {exp.slug === "footer-glow" && (
  <div class="mb-10 flex flex-col gap-10 animate-fade-in stagger-2">
    <FooterGlow text="GAIA" logoSrc="/images/experiments/gaia-footer/logo.webp" backgroundSrc="/images/experiments/footer-glow-wallpaper.jpg" fontClassName="gaia-ui-wordmark font-bold" className="rounded-2xl" client:only="react">
      <div slot="fallback" class="w-full rounded-2xl bg-[var(--muted-bg)] animate-pulse" style="aspect-ratio:16/9" aria-hidden="true" />
    </FooterGlow>
    <Tweet id="2095038928625733911" />
  </div>
  )}
  {exp.slug === "holo-card" && (
  <div class="mb-10 flex justify-center rounded-2xl bg-[var(--muted-bg)] py-14 animate-fade-in stagger-2">
    <div style="width:320px;height:448px" transition:name={`holo-${exp.slug}`}>
      <HoloCardIsland data={DEMO_CARD} width={320} height={448} client:only="react">
        <div slot="fallback" style="width:320px;height:448px" class="rounded-2xl bg-[var(--muted-bg)] animate-pulse" aria-hidden="true" />
      </HoloCardIsland>
    </div>
  </div>
  )}

  <Lightbox target=".tweet-embed img.tweet-media" />
</PageLayout>
