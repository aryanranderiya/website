---
import GaiaFooter from '@/components/experiments/gaia-footer/GaiaFooter';
import HoloCardIsland from '@/components/experiments/HoloCardIsland';
import { DEMO_CARD } from '@/components/experiments/holo-card/demo';
import { experiments } from '@/data/experiments';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout title="Experiments" description="A grid of small interactive component experiments.">
  <div class="mb-12">
    <h1 class="text-heading-1 animate-fade-in stagger-1">Experiments</h1>
  </div>

  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      experiments.map((exp, i) => (
        exp.gaiaUi ? (
        <a
          href={`/experiments/${exp.slug}`}
          class="group block cursor-pointer rounded-2xl bg-[var(--muted-bg)] p-6 animate-fade-in sm:col-span-2"
          style={`animation-delay:${0.15 + i * 0.07}s`}
          aria-label={exp.title}
        >
          {/* static native preview - title, lead, variant chips */}
          <div class="mb-1 text-[15px] font-semibold tracking-[-0.01em]">{exp.title}</div>
          <p class="mb-4 max-w-xl text-[13px] text-[var(--text-muted)] leading-relaxed">{exp.gaiaUi.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {exp.gaiaUi.variants.map((v) => (
              <span class="rounded-full border border-[var(--border)] px-2.5 py-1 text-[11px] text-[var(--text-muted)]">
                {v.name}
              </span>
            ))}
          </div>
        </a>
        ) : exp.slug === "gaia-footer" ? (
          <a
            href={`/experiments/${exp.slug}`}
            class="group block cursor-pointer overflow-hidden rounded-2xl bg-[var(--muted-bg)] animate-fade-in sm:col-span-2"
            style={`animation-delay:${0.15 + i * 0.07}s`}
            aria-label={exp.title}
          >
            {/* static preview - natural footer height; clicks open the detail */}
            <div class="pointer-events-none w-full overflow-hidden">
              <GaiaFooter client:only="react" />
            </div>
          </a>
        ) : (
        <a
          href={`/experiments/${exp.slug}`}
          class="group flex cursor-pointer items-center justify-center rounded-2xl bg-[var(--muted-bg)] py-10 animate-fade-in"
          style={`animation-delay:${0.15 + i * 0.07}s`}
          aria-label={exp.title}
        >
          {/* static preview - scaled full-size card so all proportions hold; clicks open the detail */}
          <div
            class="pointer-events-none h-[312px] w-[224px] transition-transform duration-300 ease-out group-hover:scale-[1.04]"
            transition:name={`holo-${exp.slug}`}
          >
            <div class="origin-top-left scale-[0.7]">
              {exp.slug === "holo-card" && (
                <HoloCardIsland
                  data={DEMO_CARD}
                  forceSide="front"
                  width={320}
                  height={446}
                  client:only="react"
                />
              )}
            </div>
          </div>
        </a>
        )
      ))
    }
  </div>
</PageLayout>
