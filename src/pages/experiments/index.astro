---
import HoloCardIsland from '@/components/experiments/HoloCardIsland';
import { DEMO_CARD } from '@/components/experiments/holo-card/demo';
import { experiments } from '@/data/experiments';
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout title="Experiments" description="A grid of small interactive component experiments.">
  <div class="mb-12">
    <h1 class="text-heading-1 animate-fade-in stagger-1">Experiments</h1>
  </div>

  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      experiments.map((exp, i) => (
        <a
          href={`/experiments/${exp.slug}`}
          class="group flex items-center justify-center rounded-2xl bg-[var(--muted-bg)] py-10 animate-fade-in"
          style={`animation-delay:${0.15 + i * 0.07}s`}
          aria-label={exp.title}
        >
          {/* static preview - scaled full-size card so all proportions hold; clicks open the detail */}
          <div class="pointer-events-none h-[312px] w-[224px]" transition:name={`holo-${exp.slug}`}>
            <div class="origin-top-left scale-[0.7]">
              {exp.slug === "holo-card" && (
                <HoloCardIsland
                  data={DEMO_CARD}
                  forceSide="front"
                  width={320}
                  height={446}
                  client:only="react"
                />
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
