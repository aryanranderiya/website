---
import { type CollectionEntry, getCollection } from 'astro:content';
import BackLink from '@/components/ui/BackLink.astro';
import BlogLinks from '@/components/blog/BlogLinks';
import { mdxComponents } from '@/components/blog/mdx';
import ProjectCTAs from '@/components/projects/ProjectCTAs';
import Lightbox from '@/components/ui/Lightbox.astro';
import PostNav from '@/components/ui/PostNav.astro';
import { SITE } from '@/constants/site';
import PageLayout from '@/layouts/PageLayout.astro';
import { normalizeImages, sortProjects } from '@/utils/projects';
import { getTechIconUrl } from '@/utils/techIcons';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const p = entry.data;

const formattedDate = new Date(p.date).toLocaleDateString('en-US', {
	month: 'long',
	year: 'numeric',
});
const allImages = normalizeImages(p.images);
const canonicalURL = new URL(Astro.url.pathname, SITE.url).toString();

const breadcrumbJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Projects',
			item: `${SITE.url}/projects`,
		},
		{ '@type': 'ListItem', position: 3, name: p.title, item: canonicalURL },
	],
});

const projectJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: p.title,
	description: p.description,
	url: p.url ?? canonicalURL,
	dateCreated: new Date(p.date).toISOString(),
	author: {
		'@type': 'Person',
		name: SITE.name,
		url: SITE.url,
	},
	...(p.tech && p.tech.length > 0 ? { keywords: p.tech.join(', ') } : {}),
	...(allImages[0]
		? {
				image: allImages[0].src.startsWith('http')
					? allImages[0].src
					: new URL(allImages[0].src, SITE.url).toString(),
			}
		: {}),
});

const heroImage = p.coverImage || allImages[0]?.src;
const galleryImages = allImages;
const videoAspect = p.videoAspectRatio ?? '16 / 9';

// Cycling prev/next through all projects in their sorted order.
const allProjects = sortProjects(await getCollection('projects'));
const projIndex = allProjects.findIndex((e) => e.slug === entry.slug);
const prevProject = allProjects[(projIndex - 1 + allProjects.length) % allProjects.length];
const nextProject = allProjects[(projIndex + 1) % allProjects.length];
---

<PageLayout title={p.title} description={p.description} ogImage={heroImage}>
  <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script is:inline type="application/ld+json" set:html={projectJsonLd} />

  <!-- Back nav -->
  <BackLink href="/projects" label="Back to Projects" class="mb-8" />

  <!-- Hero image: visual-first, full width -->
  {
    heroImage && (
      <div class="gallery-target mb-8 overflow-hidden rounded-xl bg-[var(--muted-bg)] cursor-zoom-in">
        <img
          src={heroImage}
          alt={p.title}
          class="block h-auto w-full object-contain max-h-100"
          loading="eager"
        />
      </div>
    )
  }

  <!-- Header -->
  <header class="mb-8">
    <!-- Title + actions: title left, Visit/GitHub right (stacks on mobile) -->
    <div
      class="flex flex-col gap-3 min-[480px]:flex-row min-[480px]:items-start min-[480px]:justify-between min-[480px]:gap-4"
    >
      <h1
        transition:name={`project-title-${entry.slug}`}
        class="m-0 text-2xl font-medium leading-[1.1] tracking-[-0.03em] text-[var(--text-primary)]"
      >
        {p.title}
      </h1>
      <ProjectCTAs url={p.url} github={p.github} />
    </div>

    <!-- Date (below title, same size/pattern as blog/slug) -->
    <time
      datetime={new Date(p.date).toISOString()}
      class="mt-0 mb-3 block text-[17px] text-(--text-ghost) tracking-[-0.01em]"
    >
      {formattedDate}
    </time>

    <!-- Tech stack -->
    {
      p.tech && p.tech.length > 0 && (
        <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          {p.tech.map((t: string) => {
            const iconUrl = getTechIconUrl(t);
            return (
              <span class="inline-flex items-center gap-[6px] text-[12px] text-(--text-ghost)">
                {iconUrl && (
                  <img
                    src={iconUrl}
                    alt=""
                    width="14"
                    height="14"
                    class="shrink-0 object-contain"
                  />
                )}
                {t}
              </span>
            );
          })}
        </div>
      )
    }

    <p
      class="m-0 max-w-[520px] text-sm leading-[1.75] tracking-[-0.01em] text-[var(--text-muted)]"
    >
      {p.description}
    </p>
  </header>

  <!-- Body content (rendered markdown) -->
  <div class="prose mb-11">
    <Content components={mdxComponents} />
  </div>

  <!-- Gallery (remaining images after hero) -->
  {
    galleryImages.length > 0 &&
      (galleryImages.some((img) => img.caption) ? (
        /* Captioned: stacked full-width figures, blog-style captions */
        <section class="mb-11 flex flex-col gap-7">
          {galleryImages.map((img, i) => (
            <figure class="m-0">
              <div class="gallery-target group relative cursor-zoom-in overflow-hidden rounded-xl bg-[var(--muted-bg)]">
                <img
                  src={img.src}
                  alt={img.caption ?? `${p.title} screenshot ${i + 1}`}
                  class="block h-auto w-full"
                  loading="lazy"
                />
              </div>
              {img.caption && (
                <figcaption class="mt-2 text-center text-[0.85em] text-[var(--text-ghost)]">
                  {img.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </section>
      ) : (
        <section id="gallery-grid-section" class="mb-11">
          {galleryImages.length === 1 && (
            <div class="gallery-target group relative cursor-zoom-in rounded-xl overflow-hidden bg-[var(--muted-bg)]">
              <img
                src={galleryImages[0].src}
                alt={`${p.title} screenshot 2`}
                class="w-full h-auto block"
                loading="lazy"
              />
            </div>
          )}
          {galleryImages.length >= 2 && (
            <div
              class="grid grid-cols-2 max-[600px]:grid-cols-1 gap-2"
              id="gallery-grid"
            >
              {galleryImages.map((img, i: number) => (
                <div class="gallery-item gallery-target group relative cursor-zoom-in [&.landscape]:col-span-2 rounded-xl overflow-hidden bg-[var(--muted-bg)]">
                  <img
                    src={img.src}
                    alt={`${p.title} screenshot ${i + 2}`}
                    class="w-full h-auto block"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          )}
        </section>
      ))
  }

  <Lightbox target=".gallery-target img" />

  <!-- Hover link previews for markdown links in the project body -->
  <BlogLinks client:idle />

  <!-- Video (if present) -->
  {
    p.video && (
      <section class="mb-11">
        <simple-player
          src={p.video}
          aspect-ratio={videoAspect}
          style={`--simple-player-aspect-ratio: ${videoAspect}`}
        />
      </section>
    )
  }

  <PostNav
    class="mt-16 pt-10 border-t border-[var(--border)]"
    backHref="/projects"
    backLabel="Back to Projects"
    prevHref={`/projects/${prevProject.slug}`}
    nextHref={`/projects/${nextProject.slug}`}
    prevLabel={prevProject.data.title}
    nextLabel={nextProject.data.title}
  />
</PageLayout>

<script>
  // Register the SimplePlayer web component used for the project video above.
  // Custom-element registration is global + idempotent, so it stays at module
  // top level — it must NOT live inside onPage (re-defining a custom element throws).
  import "@/lib/simple-player";
  import { onPage } from "@/lib/lifecycle";

  // Smart grid: landscape images span both columns. Re-runs on every swap so a
  // newly navigated-to project's gallery gets measured too.
  onPage(() => {
    const grid = document.getElementById("gallery-grid");
    if (!grid) return;
    Array.from(grid.querySelectorAll<HTMLElement>(".gallery-item")).forEach(
      (item) => {
        const img = item.querySelector("img");
        if (!img) return;
        const applySpan = () => {
          if (
            img.naturalWidth > 0 &&
            img.naturalHeight > 0 &&
            img.naturalWidth / img.naturalHeight > 1.3
          )
            item.classList.add("landscape");
        };
        img.complete
          ? applySpan()
          : img.addEventListener("load", applySpan, { once: true });
      },
    );
  });
</script>
