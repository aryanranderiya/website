---
import BackLink from '@/components/ui/BackLink.astro';
import Lightbox from '@/components/ui/Lightbox.astro';
import { photoFolders } from '@/data/photo-folders';
import PageLayout from '@/layouts/PageLayout.astro';

export function getStaticPaths() {
	return photoFolders.map((folder) => ({
		params: { slug: folder.id },
		props: { folder },
	}));
}

const { folder } = Astro.props;
const photoCount = folder.photos.length;
---

<PageLayout title={folder.name} description={`Photos from ${folder.name}.`}>
  <div class="pb-16">
    <BackLink href="/camera" label="Back to Gallery" class="animate-fade-in stagger-1" />

    <h1 class="text-heading-1 mt-3 mb-1 animate-fade-in stagger-2">{folder.name}</h1>
    <p class="text-sm text-[var(--text-muted)] mb-7 animate-fade-in stagger-3">
      {photoCount} {photoCount === 1 ? 'photo' : 'photos'}
    </p>

    <div class="columns-2 sm:columns-3 [column-gap:8px]">
      {
        folder.photos.map((photo) => (
          <div class="mb-2 break-inside-avoid overflow-hidden rounded-lg bg-[var(--muted)]">
            <img
              src={photo.url}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
              class="camera-photo block h-auto w-full"
            />
          </div>
        ))
      }
    </div>
  </div>

  <Lightbox target=".camera-photo" />
</PageLayout>
