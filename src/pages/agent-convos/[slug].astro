---
import { type CollectionEntry, getCollection } from 'astro:content';
import {
	BubbleChatIcon,
	Calendar03Icon,
	Clock01Icon,
	CpuIcon,
	Database01Icon,
	File01Icon,
	RoboticIcon,
} from '@/components/icons';
import BackLink from '@/components/ui/BackLink.astro';
import TableOfContents from '@/components/ui/TableOfContents.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatDate } from '@/lib/utils';

export async function getStaticPaths() {
	const convos = await getCollection('agent-convos');
	return convos.map((convo) => ({
		params: { slug: convo.slug },
		props: { convo },
	}));
}

interface Props {
	convo: CollectionEntry<'agent-convos'>;
}

const { convo } = Astro.props;
const { Content, headings } = await convo.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const platformLabels: Record<string, string> = {
	'claude-code': 'Claude Code',
	opencode: 'OpenCode',
	codex: 'Codex CLI',
};

// Favicon per platform — the little brand mark next to the platform name.
const platformIcons: Record<string, string> = {
	'claude-code': 'https://www.google.com/s2/favicons?domain=claude.ai&sz=64',
	opencode: 'https://www.google.com/s2/favicons?domain=opencode.ai&sz=64',
	codex: 'https://www.google.com/s2/favicons?domain=openai.com&sz=64',
};

function formatTokensExact(tokenCount?: number, tokens?: string): string | null {
	if (tokenCount) {
		if (tokenCount >= 1_000_000) return `${(tokenCount / 1_000_000).toFixed(1)}M`;
		if (tokenCount >= 1_000) return `${(tokenCount / 1_000).toFixed(0)}K`;
		return tokenCount.toLocaleString();
	}
	if (tokens) {
		return (
			tokens
				.replace(/~/g, '')
				.replace(/\s+(session|across\s+sessions?|across\s+\d+\s+sessions?).*/i, '')
				.replace(/MB/gi, 'M')
				.trim() || null
		);
	}
	return null;
}

const tokensDisplay = formatTokensExact(convo.data.tokenCount, convo.data.tokens);

// Clean two-column metadata table (replaces the old inline chip row).
const metaRow =
	'grid grid-cols-[110px_1fr] gap-4 py-[7px] [&:not(:last-child)]:[border-block-end:1px_solid_var(--border)]';
const metaLabel = 'text-[12px] text-[var(--text-ghost)]';
const metaValue =
	'inline-flex items-center gap-1.5 text-[12px] text-[var(--text-secondary)] leading-relaxed';
const metaValueMono =
	'inline-flex items-center gap-1.5 text-[11px] text-[var(--text-secondary)] [font-family:var(--font-mono)] leading-relaxed';
const metaIconColor = 'var(--text-ghost)';
---

<PageLayout
  title={convo.data.title}
  description={convo.data.description}
  ogType="article"
  articleDate={convo.data.date}
  fullWidth={true}
>
  <div class="flex ml-[max(0px,calc((100%-var(--content-max-width))/2))] gap-14 items-start px-4 min-[960px]:px-0">
  <article class="flex-1 min-w-0 max-w-[var(--content-max-width)]" style="padding-bottom: 64px;">

    {/* Back to Agent Conversations */}
    <BackLink href="/agent-convos" label="Back to Agent Conversations" class="mb-8" />

    {/* Header */}
    <header class="mb-10">
      <h1
        transition:name={`convo-title-${convo.slug}`}
        class="text-heading-1 mb-4"
      >
        {convo.data.title}
      </h1>
      <p class="text-body mb-6" style="color: var(--text-muted);">{convo.data.description}</p>

      {/* Metadata — clean two-column key/value table */}
      <dl class="mb-8 max-w-[460px]">
        <div class={metaRow}>
          <dt class={metaLabel}>Date</dt>
          <dd class={metaValue}>
            <Calendar03Icon width={13} height={13} color={metaIconColor} />
            <time datetime={convo.data.date.toISOString()}>{formatDate(convo.data.date)}</time>
          </dd>
        </div>

        <div class={metaRow}>
          <dt class={metaLabel}>Platform</dt>
          <dd class={metaValue}>
            {platformIcons[convo.data.platform] && (
              <img
                src={platformIcons[convo.data.platform]}
                alt=""
                width="14"
                height="14"
                class="shrink-0 rounded-[3px]"
              />
            )}
            {platformLabels[convo.data.platform] ?? convo.data.platform}
          </dd>
        </div>

        <div class={metaRow}>
          <dt class={metaLabel}>Model</dt>
          <dd class={metaValueMono}>
            <CpuIcon width={13} height={13} color={metaIconColor} />
            {convo.data.model}
          </dd>
        </div>

        {tokensDisplay && (
          <div class={metaRow}>
            <dt class={metaLabel}>Tokens</dt>
            <dd class={metaValue}>
              <Database01Icon width={13} height={13} color={metaIconColor} />
              {tokensDisplay}
            </dd>
          </div>
        )}

        {(convo.data.messageCount ?? 0) > 0 && (
          <div class={metaRow}>
            <dt class={metaLabel}>Messages</dt>
            <dd class={metaValue}>
              <BubbleChatIcon width={13} height={13} color={metaIconColor} />
              {convo.data.messageCount}
            </dd>
          </div>
        )}

        {convo.data.duration && (
          <div class={metaRow}>
            <dt class={metaLabel}>Duration</dt>
            <dd class={metaValue}>
              <Clock01Icon width={13} height={13} color={metaIconColor} />
              {convo.data.duration}
            </dd>
          </div>
        )}

        {(convo.data.filesChanged ?? 0) > 0 && (
          <div class={metaRow}>
            <dt class={metaLabel}>Files changed</dt>
            <dd class={metaValue}>
              <File01Icon width={13} height={13} color={metaIconColor} />
              {convo.data.filesChanged}
            </dd>
          </div>
        )}

        {convo.data.agents.length > 0 && (
          <div class={metaRow}>
            <dt class={metaLabel}>{convo.data.agents.length > 1 ? 'Agents' : 'Agent'}</dt>
            <dd class={metaValueMono}>
              <RoboticIcon width={13} height={13} color={metaIconColor} />
              {convo.data.agents.join(', ')}
            </dd>
          </div>
        )}
      </dl>

    </header>

    {/* Content */}
    <div class="prose">
      <Content />
    </div>

    {/* Footer */}
    <div class="mt-16 pt-10" style="border-top: 1px solid var(--border);">
      <BackLink href="/agent-convos" label="Back to Agent Conversations" />
    </div>
  </article>

  {tocHeadings.length > 1 && (
    <aside class="hidden min-[1080px]:block w-56 shrink-0 sticky top-[calc(var(--section-padding-top)+24px)]">
      <TableOfContents headings={headings} />
    </aside>
  )}
  </div>
</PageLayout>
