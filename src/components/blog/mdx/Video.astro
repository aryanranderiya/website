---
// Plain video embed, backed by the SimplePlayer web component
// (@grizzshutsdown/simpleplayer). Same player as <DemoVideo>, but defaults to
// click-to-play (no autoplay) for clips you don't want running on their own.
// Pass `autoplay` for the ambient muted-loop behaviour.
interface Props {
	/** Path or URL to the video file (mp4/webm). Local public/ paths work. */
	src: string;
	/** Optional caption shown beneath the video. */
	caption?: string;
	/** CSS aspect ratio for the frame. Match the clip to avoid crop. Default 16 / 9. */
	aspectRatio?: string;
	/** Muted autoplay + loop when scrolled into view. Default false. */
	autoplay?: boolean;
	/** Show the extra control tray (volume, Picture-in-Picture, fullscreen). Default false. */
	controls?: boolean;
}

const { src, caption, aspectRatio = '16 / 9', autoplay = false, controls = false } = Astro.props;
---

<figure class="my-6">
	<simple-player
		src={src}
		aspect-ratio={aspectRatio}
		controls={controls || undefined}
		disable-autoplay={autoplay ? undefined : true}
		style={`--simple-player-aspect-ratio: ${aspectRatio}`}></simple-player>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	import '@/lib/simple-player';
</script>
