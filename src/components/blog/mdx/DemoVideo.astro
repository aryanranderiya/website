---
import Video from './Video.astro';

interface Props {
	/** Path or URL to the video file (mp4/webm). Local public/ paths work. */
	src: string;
	/** Optional caption shown beneath the player. */
	caption?: string;
	/** CSS aspect ratio for the frame. Match the clip to avoid crop. Default 16 / 9. */
	aspectRatio?: string;
	/** Muted autoplay + loop when scrolled into view. Default true (unlike Video). */
	autoplay?: boolean;
	/** Show the extra control tray (volume, Picture-in-Picture, fullscreen). Default false. */
	controls?: boolean;
}

const { autoplay = true, ...rest } = Astro.props;
---

<Video autoplay={autoplay} {...rest} />
