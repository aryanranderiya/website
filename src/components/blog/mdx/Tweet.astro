---
// Embedded tweet — fetched at BUILD TIME via react-tweet's syndication API
// (getTweet) and rendered as a faithful, flat-design tweet card. Zero client
// JS, no runtime fetch. We render the markup ourselves rather than react-tweet's
// <EmbeddedTweet> because that widget won't server-render under Astro (dual
// React copy → invalid hook call) and crashes on tweets whose `entities` omit
// the hashtags/mentions arrays. getTweet (data only) is rock-solid.
//
// Quote tweets render as a nested bordered card (own header, text, media).
//
// Works in any collection's .mdx via the shared mdxComponents registry. The
// `.not-prose` wrapper keeps .prose img/a/p rules from bleeding into the card.
//
// Interaction (zero JS): the whole card is a "stretched link" — an absolutely
// positioned <a> overlay (z-10) opens the tweet in a new tab. Interactive bits
// (profile link, body links, "Show more", video, "View on Twitter") sit at
// z-20 so they capture their own clicks (video controls play, links navigate).
// The nested quote card sits at z-20 with the same pattern one level down.
import { getTweet } from 'react-tweet/api';
import {
	BubbleChatIcon,
	CheckmarkBadge01Icon,
	FavouriteIcon,
	RepostIcon,
	TwitterIcon,
} from '@/components/icons';
import TweetMedia from './TweetMedia.astro';

// gaia-icons render `fill="currentColor"` and ignore the `color` prop under
// Astro SSR, so colors are applied via the CSS `color` of a wrapper element
// (Tailwind text-[#hex]): #1da1f2 = Twitter blue, #f91880 = liked-heart red.

interface Props {
	/** Numeric status id, e.g. "2056325510431686836" (trailing part of the X URL). */
	id: string;
}

const { id } = Astro.props;

let tweet: Awaited<ReturnType<typeof getTweet>>;
try {
	tweet = await getTweet(id);
} catch {
	tweet = undefined;
}

const escapeHtml = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

// Minimal structural shape shared by tweets and nested quoted tweets — the
// syndication API omits half these fields on some tweets, so everything
// except the resolved display fields is optional with a fallback.
interface RawTweet {
	id_str?: string;
	user?: {
		name?: string;
		screen_name?: string;
		profile_image_url_https?: string;
		verified?: boolean;
		is_blue_verified?: boolean;
	} | null;
	text?: string | null;
	entities?: { urls?: { url: string; expanded_url: string; display_url: string }[] } | null;
	note_tweet?: unknown;
	conversation_count?: number | null;
	favorite_count?: number | null;
	created_at?: string | null;
	video?: { poster?: string; variants?: { type?: string; src?: string }[] } | null;
	photos?: { url: string; width?: number; height?: number }[] | null;
	mediaDetails?: { original_info?: { width?: number; height?: number } }[] | null;
	quoted_tweet?: RawTweet | null;
}

// Escape first, then linkify: t.co → real url (known ones) or a self-link,
// @mentions and #hashtags → Twitter links. Newlines preserved via pre-wrap.
function linkify(
	text: string,
	urlMap: Record<string, { expanded_url: string; display_url: string }>,
	dropUnknownTc: boolean
): string {
	let s = escapeHtml(text);
	s = s.replace(/https:\/\/t\.co\/\w+/g, (m) => {
		const u = urlMap[m];
		if (u)
			return `<a href="${escapeHtml(u.expanded_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(u.display_url)}</a>`;
		return dropUnknownTc
			? ''
			: `<a href="${escapeHtml(m)}" target="_blank" rel="noopener noreferrer">${escapeHtml(m)}</a>`;
	});
	s = s.replace(
		/(^|[^\w@/])@(\w{1,15})/g,
		(_, p, h) =>
			`${p}<a href="https://twitter.com/${h}" target="_blank" rel="noopener noreferrer">@${h}</a>`
	);
	s = s.replace(
		/(^|[^\w&/])#(\w+)/g,
		(_, p, h) =>
			`${p}<a href="https://twitter.com/hashtag/${h}" target="_blank" rel="noopener noreferrer">#${h}</a>`
	);
	return s.trim();
}

function urlMapOf(t: RawTweet): Record<string, { expanded_url: string; display_url: string }> {
	const urlMap: Record<string, { expanded_url: string; display_url: string }> = {};
	for (const u of t.entities?.urls ?? []) urlMap[u.url] = u;
	return urlMap;
}

function buildTextHtml(t: RawTweet): string {
	return linkify(t.text ?? '', urlMapOf(t), true);
}

// Long-form notes are truncated by the syndication API (~280 chars) with no
// full text attached, and it exposes no retweet count either. FxTwitter fills
// both gaps — best-effort at build time, silent fallback on any failure.
async function fetchFxTweet(
	handle: string,
	statusId: string
): Promise<{ text: string | null; retweets: number | null }> {
	const fallback = { text: null, retweets: null };
	try {
		const res = await fetch(`https://api.fxtwitter.com/${handle}/status/${statusId}`, {
			headers: {
				'user-agent':
					'Mozilla/5.0 (compatible; aryanranderiya.com/tweet-embed; +https://aryanranderiya.com)',
				accept: 'application/json',
			},
			signal: AbortSignal.timeout(5000),
		});
		if (!res.ok) return fallback;
		const data = (await res.json()) as {
			tweet?: { text?: string; retweets?: number };
		};
		const text = data.tweet?.text?.trim();
		return {
			text: text ? text : null,
			retweets: typeof data.tweet?.retweets === 'number' ? data.tweet.retweets : null,
		};
	} catch {
		return fallback;
	}
}

// Collapse point for the inline "Show more" — long enough that typical notes
// render whole with no toggle at all.
const VISIBLE_CHARS = 600;

function splitVisible(s: string): [string, string] {
	if (s.length <= VISIBLE_CHARS) return [s, ''];
	const cut = s.indexOf(' ', VISIBLE_CHARS);
	if (cut < 0) return [s, ''];
	return [s.slice(0, cut), s.slice(cut + 1)];
}

// Pick a sensibly-sized mp4 (largest variant ≤ 1280px wide) for native playback.
function pickMp4(t: RawTweet): { src: string } | null {
	// Single pass: filter to mp4-with-src and project to { src, w, h } together.
	const mp4s: { src: string; w: number; h: number }[] = [];
	for (const v of t.video?.variants ?? []) {
		if (v.type !== 'video/mp4' || !v.src) continue;
		const m = v.src.match(/\/(\d+)x(\d+)\//);
		mp4s.push({ src: v.src, w: m ? Number(m[1]) : 0, h: m ? Number(m[2]) : 0 });
	}
	mp4s.sort((a, b) => a.w - b.w);
	if (!mp4s.length) return null;
	const capped = mp4s.filter((v) => v.w <= 1280);
	return capped.length ? capped[capped.length - 1] : mp4s[mp4s.length - 1];
}

function mediaAspect(t: RawTweet): string {
	const info = t.mediaDetails?.[0]?.original_info;
	return info?.width && info?.height ? `${info.width} / ${info.height}` : '16 / 9';
}

// Twitter's video CDN 403s hotlinked playback from our referer (verified:
// ranged GET returns 206 with no/x.com referer, 403 with ours). Check with
// OUR referer at build time; on failure drop the video and show its poster
// as a plain photo instead of a dead player.
async function videoAllowed(src: string): Promise<boolean> {
	try {
		const res = await fetch(src, {
			method: 'GET',
			headers: {
				Range: 'bytes=0-0',
				Referer: 'https://aryanranderiya.com/',
				'user-agent':
					'Mozilla/5.0 (compatible; aryanranderiya.com/tweet-embed; +https://aryanranderiya.com)',
			},
			signal: AbortSignal.timeout(5000),
		});
		if (!res.ok) return false;
		try {
			await res.body?.cancel();
		} catch {
			// body already closed — status is all we needed
		}
		return true;
	} catch {
		return false;
	}
}

// Tweets whose video CDN blocks our referer: serve a vendored copy instead
// (verified playable — the remote URL 403s only when hotlinked from us).
const LOCAL_VIDEO_OVERRIDES: Record<string, string> = {
	'2095038928625733911': '/images/experiments/footer-glow-tweet.mp4',
};

async function summarize(raw: RawTweet, fallbackId: string, fxRetweets: number | null = null) {
	const handle = raw.user?.screen_name;
	if (!handle) return null;
	const statusId = raw.id_str ?? fallbackId;
	const video = pickMp4(raw);
	const photos = [...(raw.photos ?? [])];
	let resolvedVideo = video;
	if (LOCAL_VIDEO_OVERRIDES[statusId]) {
		resolvedVideo = { src: LOCAL_VIDEO_OVERRIDES[statusId] };
	} else if (video) {
		if (!(await videoAllowed(video.src))) {
			// Dead player → poster photo (opens in the lightbox like photos).
			resolvedVideo = null;
			if (raw.video?.poster) photos.unshift({ url: raw.video.poster });
		}
	}
	return {
		name: raw.user?.name ?? `@${handle}`,
		handle,
		avatar: (raw.user?.profile_image_url_https ?? '').replace('_normal', '_bigger'),
		verified: Boolean(raw.user?.is_blue_verified || raw.user?.verified),
		textHtml: buildTextHtml(raw),
		// Long-form ("note") tweets are truncated by the syndication API; the
		// remainder only lives on Twitter, so offer a working "Show more".
		isLongform: Boolean(raw.note_tweet),
		replies: raw.conversation_count ?? 0,
		likes: raw.favorite_count ?? 0,
		retweets: fxRetweets,
		date: raw.created_at
			? new Date(raw.created_at).toLocaleDateString('en-US', {
					month: 'long',
					day: 'numeric',
					year: 'numeric',
				})
			: '',
		tweetUrl: `https://twitter.com/${handle}/status/${statusId}`,
		profileUrl: `https://twitter.com/${handle}`,
		video: resolvedVideo,
		videoPoster: raw.video?.poster,
		photos,
		aspect: mediaAspect(raw),
		moreHtml: '',
	};
}

const data = tweet ? await summarize(tweet, id) : null;
const rawQuoted = tweet?.quoted_tweet;
const quoted = rawQuoted ? await summarize(rawQuoted, rawQuoted.id_str ?? id) : null;

// Full note text + retweet count for the inline expander (outer tweet only).
// FxTwitter supplements what the syndication API omits.
if (data && tweet?.user?.screen_name) {
	const fx = await fetchFxTweet(tweet.user.screen_name, id);
	if (tweet.note_tweet) {
		const full = fx.text;
		if (full && full !== (tweet.text ?? '').trim()) {
			const [visible, rest] = splitVisible(full);
			if (rest) {
				const map = urlMapOf(tweet);
				data.textHtml = linkify(visible, map, false);
				data.moreHtml = ` ${linkify(rest, map, false)}`;
			}
		}
	}
	data.retweets = fx.retweets;
}
---

{
	data ? (
		<div class="tweet-embed not-prose group relative my-6 cursor-pointer rounded-2xl bg-[var(--muted-bg)] p-4 transition-colors hover:bg-[var(--muted-bg-strong)] sm:p-5">
			{/* Stretched link: whole-card click opens the tweet in a new tab. */}
			<a
				href={data.tweetUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`Open ${data.name}'s tweet on Twitter`}
				class="absolute inset-0 z-10 rounded-2xl"
			/>

			{/* Header */}
			<div class="flex items-center gap-3">
				<a
					href={data.profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="relative z-20 shrink-0"
				>
					<img
						src={data.avatar}
						alt={data.name}
						width="44"
						height="44"
						loading="lazy"
						class="h-11 w-11 rounded-full object-cover"
					/>
				</a>
				<a
					href={data.profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="relative z-20 min-w-0 leading-tight"
				>
					<span class="flex items-center gap-1 text-[14px] font-semibold text-[var(--text-primary)]">
						<span class="truncate">{data.name}</span>
						{data.verified && (
							<span class="inline-flex shrink-0 text-[#1da1f2]">
								<CheckmarkBadge01Icon width={15} height={15} />
							</span>
						)}
					</span>
					<span class="block truncate text-[13px] text-[var(--text-ghost)]">@{data.handle}</span>
				</a>
				<a
					href={data.tweetUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="View on Twitter"
					class="relative z-20 ml-auto shrink-0"
				>
					<span class="inline-flex text-[#1da1f2]">
						<TwitterIcon width={20} height={20} />
					</span>
				</a>
			</div>

			{/* Body — remainder expands inline via "Show more" below */}
			<p class="tweet-text mt-3 whitespace-pre-wrap text-[14px] leading-[1.6] text-[var(--text-secondary)]">
				<span set:html={data.textHtml} />
				{data.moreHtml && <span data-tweet-more hidden set:html={data.moreHtml} />}
			</p>
			{data.moreHtml && (
				<div class="mt-2">
					<button
						type="button"
						data-tweet-toggle
						aria-expanded="false"
						class="tweet-link tweet-toggle relative z-20 text-[14px]"
					>
						Show more
					</button>
				</div>
			)}
			{!data.moreHtml && data.isLongform && (
				<div class="mt-2">
					<a
						href={data.tweetUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="tweet-link relative z-20 inline-block text-[14px]"
					>
						Show more
					</a>
				</div>
			)}

			{/* Media: native video, or photo(s) */}
			<TweetMedia
				video={data.video}
				videoPoster={data.videoPoster}
				photos={data.photos}
				aspect={data.aspect}
			/>

			{/* Quoted tweet: nested bordered card with its own header, text, media */}
			{quoted && (
				<div class="relative z-20 mt-3 rounded-xl border border-[var(--border)] p-3">
					<a
						href={quoted.tweetUrl}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Open ${quoted.name}'s quoted tweet on Twitter`}
						class="absolute inset-0 rounded-xl"
					/>
					<div class="flex items-center gap-2">
						<a
							href={quoted.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="relative z-10 shrink-0"
						>
							<img
								src={quoted.avatar}
								alt={quoted.name}
								width="32"
								height="32"
								loading="lazy"
								class="h-8 w-8 rounded-full object-cover"
							/>
						</a>
						<a
							href={quoted.profileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="relative z-10 min-w-0 leading-tight"
						>
							<span class="flex items-center gap-1 text-[13px] font-semibold text-[var(--text-primary)]">
								<span class="truncate">{quoted.name}</span>
								{quoted.verified && (
									<span class="inline-flex shrink-0 text-[#1da1f2]">
										<CheckmarkBadge01Icon width={13} height={13} />
									</span>
								)}
							</span>
							<span class="block truncate text-[12px] text-[var(--text-ghost)]">
								@{quoted.handle}
							</span>
						</a>
					</div>
					<p
						class="tweet-text mt-2 whitespace-pre-wrap text-[13.5px] leading-[1.6] text-[var(--text-secondary)]"
						set:html={quoted.textHtml}
					/>
					<TweetMedia
						video={quoted.video}
						videoPoster={quoted.videoPoster}
						photos={quoted.photos}
						aspect={quoted.aspect}
						clamp
					/>
				</div>
			)}

			{/* Footer: replies, reposts, likes, date, view on Twitter */}
			<div class="mt-3 flex items-center gap-4 text-[13px] text-[var(--text-ghost)]">
				<span class="inline-flex items-center gap-1.5">
					<BubbleChatIcon width={19} height={19} />
					<span class="text-[14px]">{data.replies.toLocaleString()}</span>
				</span>
				{data.retweets != null && (
					<span class="inline-flex items-center gap-1.5">
						<span class="inline-flex">
							<RepostIcon width={19} height={19} />
						</span>
						<span class="text-[14px]">{data.retweets.toLocaleString()}</span>
					</span>
				)}
				<span class="inline-flex items-center gap-1.5">
					<span class="inline-flex text-[#f91880]">
						<FavouriteIcon width={19} height={19} />
					</span>
					<span class="text-[14px]">{data.likes.toLocaleString()}</span>
				</span>
				<span class="hidden sm:inline">{data.date}</span>
				<a
					href={data.tweetUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="tweet-link relative z-20 ml-auto inline-flex items-center gap-1.5"
				>
					View on Twitter
					<TwitterIcon width={14} height={14} />
				</a>
			</div>
		</div>
	) : (
		<p class="tweet-embed-fallback">
			<a href={`https://twitter.com/i/status/${id}`} target="_blank" rel="noopener noreferrer">
				View tweet on Twitter →
			</a>
		</p>
	)
}

<style>
	/* Body links + the "Show more"/"View on Twitter" links use Twitter blue
	   (faithful to a real tweet) and sit above the stretched-link overlay so
	   they navigate on their own. The .not-prose wrapper strips global .prose a
	   styles, so re-state them here. */
	.tweet-text a {
		position: relative;
		z-index: 20;
		color: #1da1f2;
	}
	.tweet-text a:hover,
	.tweet-link:hover {
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.tweet-link {
		color: #1da1f2;
	}
	.tweet-toggle {
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
		font: inherit;
	}
</style>

<script is:inline>
	// Inline "Show more/less" for long notes — no framework, works everywhere
	// the static card renders. Re-bound after ClientRouter swaps.
	(function () {
		function bind() {
			document.querySelectorAll('[data-tweet-toggle]').forEach(function (btn) {
				if (btn.dataset.tweetBound) return;
				btn.dataset.tweetBound = '1';
				btn.addEventListener('click', function () {
					var card = btn.closest('.tweet-embed');
					var more = card ? card.querySelector('[data-tweet-more]') : null;
					if (!more) return;
					var expanded = btn.getAttribute('aria-expanded') === 'true';
					btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
					if (expanded) more.setAttribute('hidden', '');
					else more.removeAttribute('hidden');
					btn.textContent = expanded ? 'Show more' : 'Show less';
				});
			});
		}
		document.addEventListener('astro:page-load', bind);
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', bind, { once: true });
		} else {
			bind();
		}
	})();
</script>
