---
interface RelatedPost {
	slug: string;
	title: string;
	date: string;
	featured?: boolean;
}

interface Props {
	posts: RelatedPost[];
}

const { posts } = Astro.props;

function formatDate(dateStr: string): string {
	return new Date(dateStr).toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
	});
}
---

{posts.length > 0 && (
  <aside class="not-prose mt-10">
    <p class="mb-3 font-medium text-[13px] text-[var(--text-ghost)]">Related posts</p>
    <div class="dim-list related-list flex flex-col gap-1">
      {posts.map(post => (
        <a
          href={`/${post.slug}`}
          class="dim-list-row group/item -mx-2 flex items-center gap-[14px] rounded-[var(--radius-md)] px-2 py-[10px] no-underline transition-colors hover:bg-[var(--muted-bg)]"
        >
          <div class="flex min-w-0 flex-1 items-center gap-2">
            <span class="truncate font-medium text-[13px] text-[var(--text-secondary)] tracking-[-0.01em] transition-colors duration-150 group-hover/item:text-[var(--text-primary)]">
              {post.title}
            </span>
            {post.featured && (
              <span class="shrink-0 rounded-full bg-[var(--muted-bg)] px-1.5 py-[2px] font-normal text-[10px] text-[var(--text-ghost)] tracking-[0.02em]">
                Featured
              </span>
            )}
          </div>
          <time class="shrink-0 text-[13px] text-[var(--text-ghost)]">
            {formatDate(post.date)}
          </time>
        </a>
      ))}
    </div>
  </aside>
)}
