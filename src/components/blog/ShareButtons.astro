---
import { HugeiconsIcon, Link04Icon } from '@icons';

interface Props {
	title: string;
	url: string;
}
const { url } = Astro.props;
---

<div class="flex items-center justify-center">
  <button
    id="copy-link-btn"
    class="inline-flex items-center gap-1.5 text-xs px-3.5 py-2 rounded-full bg-[var(--muted-bg)] text-[var(--text-muted)] transition-colors duration-150 hover:bg-[var(--muted-bg-strong)] hover:text-[var(--text-secondary)] active:scale-95"
    aria-label="Copy link"
    data-url={url}
  >
    <HugeiconsIcon icon={Link04Icon} size={16} />
    <span id="copy-label">Copy link</span>
  </button>
</div>

<script>
  import { onPage } from "@/lib/lifecycle";

  onPage(() => {
    const btn = document.getElementById("copy-link-btn");
    const label = document.getElementById("copy-label");
    if (!btn) return;

    const onClick = async () => {
      const url = (btn as HTMLButtonElement).dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = "Copied!";
        setTimeout(() => {
          if (label) label.textContent = "Copy link";
        }, 2000);
      } catch {
        // Fallback for browsers without clipboard API
        const input = document.createElement("input");
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand("copy");
        document.body.removeChild(input);
        if (label) label.textContent = "Copied!";
        setTimeout(() => {
          if (label) label.textContent = "Copy link";
        }, 2000);
      }
    };

    btn.addEventListener("click", onClick);
    return () => btn.removeEventListener("click", onClick);
  });
</script>
