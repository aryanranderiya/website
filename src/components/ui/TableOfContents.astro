---
import { HugeiconsIcon, Image01Icon, TextAlignLeftIcon } from '@icons';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<nav id="toc" aria-label="Table of contents" hidden>
  <p class="flex items-center gap-[5px] text-[10px] font-medium tracking-[0.08em] uppercase text-[var(--text-ghost)] mb-[10px]">
    <HugeiconsIcon icon={TextAlignLeftIcon} size={11} color="var(--text-ghost)" />
    On this page
  </p>
  <div class="toc-list-wrapper">
    <div id="toc-indicator" aria-hidden="true" />
    <ul id="toc-list" class="list-none p-0 m-0 flex flex-col gap-px">
      {toc.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              'toc-link block leading-[1.5] py-[3px] no-underline',
              h.depth === 3 ? 'pl-[10px] text-[11px]' : 'text-[11.5px]',
            ]}
            data-heading={h.slug}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Cloned by JS for line-mode image entries so icons stay gaia-icons. -->
  <template id="toc-img-icon">
    <HugeiconsIcon icon={Image01Icon} size={12} color="var(--text-ghost)" />
  </template>
</nav>

<!-- Global (not scoped) because the list entries are (re)built in JS, and
     Astro's scoped styles don't reach JS-created elements. All selectors are
     namespaced under #toc so nothing leaks. -->
<style is:global>
  #toc .toc-list-wrapper {
    position: relative;
    padding-left: 12px;
  }

  #toc #toc-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 20px;
    border-radius: 1px;
    background: var(--text-primary);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.45s cubic-bezier(0.19, 1, 0.22, 1),
      height 0.45s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.2s ease;
  }

  #toc .toc-link {
    color: var(--text-ghost);
    transition: color 0.15s ease;
  }

  #toc .toc-link.active,
  #toc .toc-link:hover {
    color: var(--text-primary);
  }

  /* Image entries */
  #toc .toc-link.toc-img {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  #toc .toc-link .toc-thumb {
    width: 1.45em;
    height: 1.45em;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 3px;
    margin: 0;
    background: var(--muted-bg);
    /* Smooth the rotated edges (avoids jagged aliasing on the tilt). */
    transform: rotate(var(--toc-thumb-rot, 0deg)) translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    image-rendering: auto;
    will-change: transform;
    transition: transform 0.25s cubic-bezier(0.19, 1, 0.22, 1);
  }

  #toc .toc-link:hover .toc-thumb {
    transform: rotate(0deg) translateZ(0);
  }

  #toc .toc-link .toc-img-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #toc .toc-link.toc-img svg {
    flex-shrink: 0;
  }

  /* Cursor-following hover preview (appended to <body>). */
  .toc-preview {
    position: fixed;
    z-index: 80;
    top: 0;
    left: 0;
    pointer-events: none;
    border-radius: 8px;
    overflow: hidden;
    background: var(--muted-bg);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: scale(0.78);
    transform-origin: center;
    transition:
      opacity 0.16s ease,
      transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .toc-preview img {
    display: block;
    width: 240px;
    max-width: 40vw;
    height: auto;
    margin: 0;
  }

  .toc-preview.toc-preview--visible {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  let tocObserver: IntersectionObserver | null = null;

  function buildToc() {
    const nav = document.getElementById('toc');
    const list = document.getElementById('toc-list');
    const content = document.querySelector('.prose');
    if (!nav || !list || !content) return;

    // Collect headings + tagged images in document order.
    const nodes = Array.from(
      content.querySelectorAll<HTMLElement>('h2[id], h3[id], [data-toc]'),
    );

    const iconTpl = document.getElementById('toc-img-icon') as HTMLTemplateElement | null;
    const frag = document.createDocumentFragment();
    let count = 0;
    let imgIndex = 0;

    for (const node of nodes) {
      if (!node.id) continue;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${node.id}`;
      a.dataset.heading = node.id;

      if (node.hasAttribute('data-toc')) {
        const label = node.dataset.tocLabel ?? '';
        const mode = node.dataset.tocMode === 'line' ? 'line' : 'inline';
        const thumb = node.dataset.tocThumb ?? '';
        a.className = 'toc-link toc-img block py-[4px] no-underline text-[11px]';

        if (thumb) a.dataset.preview = thumb;

        if (mode === 'inline' && thumb) {
          const img = document.createElement('img');
          img.className = 'toc-thumb';
          img.src = thumb;
          img.alt = '';
          img.loading = 'lazy';
          // Alternate a slight tilt for a scattered-photo feel.
          img.style.setProperty('--toc-thumb-rot', imgIndex % 2 === 0 ? '-5deg' : '5deg');
          imgIndex += 1;
          a.appendChild(img);
        } else if (iconTpl) {
          a.appendChild(iconTpl.content.cloneNode(true));
        }

        const span = document.createElement('span');
        span.className = 'toc-img-label';
        span.textContent = label;
        a.appendChild(span);
      } else {
        const isH3 = node.tagName === 'H3';
        a.className = isH3
          ? 'toc-link block leading-[1.5] py-[3px] no-underline pl-[10px] text-[11px]'
          : 'toc-link block leading-[1.5] py-[3px] no-underline text-[11.5px]';
        a.textContent = node.textContent;
      }

      li.appendChild(a);
      frag.appendChild(li);
      count += 1;
    }

    // Only show the TOC when there are at least two entries.
    if (count < 2) {
      nav.hidden = true;
      const aside = nav.closest('aside');
      if (aside) (aside as HTMLElement).style.display = 'none';
      return;
    }

    list.replaceChildren(frag);
    nav.hidden = false;
  }

  function initToc() {
    buildToc();

    if (tocObserver) {
      tocObserver.disconnect();
      tocObserver = null;
    }

    const indicator = document.getElementById('toc-indicator') as HTMLElement | null;
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#toc .toc-link'));
    if (!links.length) return;

    function moveIndicator(link: HTMLAnchorElement) {
      if (!indicator) return;
      indicator.style.opacity = '1';
      indicator.style.transform = `translateY(${link.offsetTop}px)`;
      indicator.style.height = `${link.offsetHeight}px`;
    }

    function setActive(id: string) {
      let found: HTMLAnchorElement | null = null;
      for (const link of links) {
        if (link.dataset.heading === id) {
          link.classList.add('active');
          found = link;
        } else {
          link.classList.remove('active');
        }
      }
      if (found) moveIndicator(found);
    }

    const firstLink = links[0];
    if (firstLink) {
      firstLink.classList.add('active');
      requestAnimationFrame(() => moveIndicator(firstLink));
    }

    tocObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    );

    links.forEach((link) => {
      const id = link.dataset.heading;
      if (id) {
        const el = document.getElementById(id);
        if (el) tocObserver!.observe(el);
      }
    });

    wireImagePreview();
  }

  // Floating preview that scales up and follows the cursor on image entries.
  let preview: HTMLDivElement | null = null;
  let previewImg: HTMLImageElement | null = null;

  function ensurePreview() {
    if (preview) return;
    preview = document.createElement('div');
    preview.className = 'toc-preview';
    previewImg = document.createElement('img');
    preview.appendChild(previewImg);
    document.body.appendChild(preview);
  }

  function movePreview(e: MouseEvent) {
    if (!preview) return;
    const gap = 16;
    const w = preview.offsetWidth;
    const h = preview.offsetHeight;
    // Anchor to the left of the TOC rail so it never overlaps the entries;
    // only the vertical position tracks the cursor.
    const nav = document.getElementById('toc');
    const railLeft = nav ? nav.getBoundingClientRect().left : e.clientX;
    let left = railLeft - gap - w;
    if (left < 8) left = 8; // fallback on narrow viewports
    let top = e.clientY - h / 2;
    top = Math.max(8, Math.min(top, window.innerHeight - h - 8));
    preview.style.left = `${left}px`;
    preview.style.top = `${top}px`;
  }

  function wireImagePreview() {
    const imgLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('#toc .toc-link.toc-img'),
    );
    for (const link of imgLinks) {
      const src = link.dataset.preview;
      if (!src) continue;

      link.addEventListener('mouseenter', (e) => {
        ensurePreview();
        if (previewImg && previewImg.src !== src) previewImg.src = src;
        movePreview(e as MouseEvent);
        requestAnimationFrame(() => preview?.classList.add('toc-preview--visible'));
      });

      link.addEventListener('mousemove', (e) => movePreview(e as MouseEvent));

      link.addEventListener('mouseleave', () => {
        preview?.classList.remove('toc-preview--visible');
      });
    }
  }

  document.addEventListener('astro:page-load', initToc);
</script>
