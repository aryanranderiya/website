---
// Reusable "← Back to X" link. Used at the top (and bottom) of post/detail
// pages — blog, projects, agent conversations, camera. Faint by default;
// on hover the arrow nudges left and the text darkens slightly.
import { CircleArrowLeft02Icon } from '@/components/icons';

interface Props {
	href: string;
	label: string;
	/** Extra classes (e.g. spacing) merged onto the link. */
	class?: string;
}

const { href, label, class: className } = Astro.props;
---

<a
	href={href}
	class:list={[
		'group inline-flex items-center gap-1.5 text-xs text-[var(--text-faint)]! no-underline! transition-colors duration-150 hover:text-[var(--text-secondary)]!',
		className,
	]}
>
	<span class="inline-flex transition-transform duration-200 ease-out group-hover:-translate-x-0.5">
		<CircleArrowLeft02Icon width={15} height={15} />
	</span>
	{label}
</a>
