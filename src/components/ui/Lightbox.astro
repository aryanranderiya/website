---
// Thin Astro wrapper around the shared FLIP lightbox engine (src/lib/flip-lightbox).
// Pass a CSS selector via `target` and every matching <img> opens the same
// shared, zoom-from-position lightbox used across the whole site. Used by the
// blog layout, the camera slug page, and the project slug galleries.

interface Props {
	/** CSS selector for images that should open the lightbox on click. */
	target: string;
}

const { target } = Astro.props;
---

<div class="lb-config" data-lb-target={target} hidden></div>

<script>
	import { bindSelector } from '@/lib/flip-lightbox';
	import { onPage } from '@/lib/lifecycle';

	// Re-bind on the initial load AND after every <ClientRouter /> view
	// transition (the body swap brings in fresh <img> elements). bindSelector is
	// idempotent, so re-running it only wires up newly-added images.
	onPage(() => {
		document.querySelectorAll<HTMLElement>('.lb-config').forEach((node) => {
			const sel = node.dataset.lbTarget;
			if (sel) bindSelector(sel);
		});
	});
</script>
