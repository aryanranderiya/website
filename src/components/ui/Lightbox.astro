---
// Reusable image lightbox. Wire any set of <img> elements up to a modal by
// passing a CSS selector via `target`. Used by the projects slug page
// (gallery images) and the blog layout (every image in `.prose`).

interface Props {
	/** CSS selector for images that should open the modal on click. */
	target: string;
}

const { target } = Astro.props;
---

<script is:inline define:vars={{ TARGET: target }}>
	// The overlay is appended to <body>. Astro's <ClientRouter /> swaps the
	// body on every client-side navigation, which DESTROYS the appended
	// overlay. So initialization must be idempotent and re-run on every page
	// load (initial + each view transition) — a one-time guard would leave a
	// dangling reference and only the backdrop-blur would fire on later pages.
	(function () {
		const DURATION = 180;

		// Mutable refs — refreshed every time the overlay is (re)built.
		const els = {};
		let srcs = [];
		let alts = [];
		let index = 0;

		function buildOverlay() {
			let overlay = document.getElementById('lb-overlay');
			if (overlay) {
				cacheEls(overlay);
				return;
			}
			overlay = document.createElement('div');
			overlay.id = 'lb-overlay';
			overlay.innerHTML = `
				<div id="lb-backdrop"></div>
				<button id="lb-close" type="button" aria-label="Close"></button>
				<button id="lb-prev" type="button" aria-label="Previous"></button>
				<button id="lb-next" type="button" aria-label="Next"></button>
				<div id="lb-img-wrap">
					<div id="lb-shimmer" aria-hidden="true"></div>
					<img id="lb-img" src="" alt="" />
				</div>
				<div id="lb-counter"></div>
			`;
			document.body.appendChild(overlay);
			cacheEls(overlay);

			// Per-overlay listeners — attached once at creation. When the
			// overlay is destroyed by a body swap its listeners go with it,
			// and the freshly built one gets its own.
			els.close.addEventListener('click', close);
			els.backdrop.addEventListener('click', close);
			els.prev.addEventListener('click', () => showImage(index - 1));
			els.next.addEventListener('click', () => showImage(index + 1));
		}

		function cacheEls(overlay) {
			els.overlay = overlay;
			els.img = overlay.querySelector('#lb-img');
			els.shimmer = overlay.querySelector('#lb-shimmer');
			els.wrap = overlay.querySelector('#lb-img-wrap');
			els.counter = overlay.querySelector('#lb-counter');
			els.prev = overlay.querySelector('#lb-prev');
			els.next = overlay.querySelector('#lb-next');
			els.close = overlay.querySelector('#lb-close');
			els.backdrop = overlay.querySelector('#lb-backdrop');
		}

		function showImage(i) {
			index = (i + srcs.length) % srcs.length;
			const nextSrc = srcs[index];

			// Use the on-page thumbnail's aspect ratio to size the shimmer so
			// it doesn't flash as a square before the full asset arrives.
			const sourceImg = document.querySelectorAll(TARGET)[index];
			const ratio =
				sourceImg && sourceImg.naturalWidth && sourceImg.naturalHeight
					? sourceImg.naturalWidth / sourceImg.naturalHeight
					: 16 / 9;
			els.wrap.style.aspectRatio = String(ratio);

			els.img.style.opacity = '0';
			els.shimmer.style.display = 'block';

			const settle = () => {
				els.shimmer.style.display = 'none';
				els.wrap.style.aspectRatio = '';
				els.img.style.opacity = '1';
			};

			// Skip shimmer entirely if the new source is already cached.
			const probe = new Image();
			probe.src = nextSrc;
			els.img.src = nextSrc;
			els.img.alt = alts[index] ?? '';
			if (probe.complete && probe.naturalWidth > 0) {
				settle();
			} else {
				els.img.onload = settle;
				els.img.onerror = settle;
			}

			els.counter.textContent = srcs.length > 1 ? `${index + 1} / ${srcs.length}` : '';
			els.prev.hidden = srcs.length < 2;
			els.next.hidden = srcs.length < 2;
		}

		function open(i) {
			buildOverlay();
			showImage(i);
			els.overlay.style.display = 'flex';
			// Force a reflow so the opacity:0 start state is committed before
			// flipping to 1 — otherwise the transition can be skipped and the
			// image snaps in a frame before the (expensive) backdrop-filter
			// composites, which reads as "image first, blur after".
			void els.overlay.offsetWidth;
			els.overlay.style.opacity = '1';
			document.body.style.overflow = 'hidden';
		}

		function close() {
			els.overlay.style.opacity = '0';
			setTimeout(() => {
				els.overlay.style.display = 'none';
			}, DURATION);
			document.body.style.overflow = '';
		}

		function collect() {
			const imgs = Array.from(document.querySelectorAll(TARGET));
			srcs = imgs.map((el) => el.currentSrc || el.src);
			alts = imgs.map((el) => el.alt || '');
			imgs.forEach((img, i) => {
				if (img.dataset.lbBound) return;
				img.dataset.lbBound = '1';
				img.style.cursor = 'zoom-in';
				img.addEventListener('click', (e) => {
					e.preventDefault();
					const fresh = Array.from(document.querySelectorAll(TARGET));
					srcs = fresh.map((el) => el.currentSrc || el.src);
					alts = fresh.map((el) => el.alt || '');
					open(i);
				});
			});
		}

		function init() {
			buildOverlay();
			collect();
		}

		// Global keydown — registered once on window; reads live state so it
		// keeps working across rebuilt overlays.
		if (!window.__lbKeyBound) {
			window.__lbKeyBound = true;
			window.addEventListener('keydown', (e) => {
				const o = document.getElementById('lb-overlay');
				if (!o || o.style.display !== 'flex') return;
				if (e.key === 'Escape') close();
				if (e.key === 'ArrowLeft') showImage(index - 1);
				if (e.key === 'ArrowRight') showImage(index + 1);
			});
		}

		// Re-init on every navigation. astro:page-load fires on the initial
		// load AND after every <ClientRouter /> view transition, so the
		// overlay is rebuilt whenever the body swap removed it. Registered
		// once to avoid stacking listeners when multiple pages embed this.
		if (!window.__lbPageBound) {
			window.__lbPageBound = true;
			document.addEventListener('astro:page-load', init);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init, { once: true });
		} else {
			init();
		}
	})();
</script>

<style is:global>
	#lb-overlay {
		display: none;
		opacity: 0;
		position: fixed;
		inset: 0;
		z-index: 9999;
		align-items: center;
		justify-content: center;
		transition: opacity 180ms ease;
	}

	#lb-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(16px) brightness(0.7);
		-webkit-backdrop-filter: blur(16px) brightness(0.7);
	}

	#lb-img-wrap {
		position: relative;
		z-index: 1;
		max-width: min(92vw, 1200px);
		max-height: 88vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	#lb-img {
		max-width: 100%;
		max-height: 88vh;
		width: auto;
		height: auto;
		border-radius: 10px;
		display: block;
		transition: opacity 200ms ease;
		object-fit: contain;
	}

	/* Shimmer placeholder shown until the full image loads. Sized to the
	   wrapper (the wrapper gets an aspect-ratio hint in JS based on the
	   thumbnail) so it matches the final image footprint. */
	#lb-shimmer {
		position: absolute;
		inset: 0;
		border-radius: 10px;
		width: 100%;
		height: 100%;
		background:
			linear-gradient(
				110deg,
				rgba(255, 255, 255, 0.04) 8%,
				rgba(255, 255, 255, 0.12) 18%,
				rgba(255, 255, 255, 0.04) 33%
			)
			rgba(255, 255, 255, 0.05);
		background-size: 220% 100%;
		animation: lb-shimmer 1.4s linear infinite;
		pointer-events: none;
	}

	@keyframes lb-shimmer {
		from { background-position: 220% 0; }
		to   { background-position: -120% 0; }
	}

	#lb-close,
	#lb-prev,
	#lb-next {
		position: absolute;
		z-index: 2;
		background: rgba(255, 255, 255, 0.1);
		border: none;
		cursor: pointer;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 150ms ease;
	}

	#lb-close {
		top: 20px;
		right: 20px;
		width: 36px;
		height: 36px;
		border-radius: 50%;
	}
	#lb-close::before,
	#lb-close::after {
		content: '';
		position: absolute;
		width: 14px;
		height: 1.5px;
		background: currentColor;
		border-radius: 2px;
	}
	#lb-close::before { transform: rotate(45deg); }
	#lb-close::after { transform: rotate(-45deg); }

	#lb-prev,
	#lb-next {
		top: 50%;
		transform: translateY(-50%);
		width: 40px;
		height: 40px;
		border-radius: 50%;
	}
	#lb-prev { left: 20px; }
	#lb-next { right: 20px; }

	#lb-prev::after,
	#lb-next::after {
		content: '';
		width: 8px;
		height: 8px;
		border-top: 1.5px solid currentColor;
		border-right: 1.5px solid currentColor;
		display: block;
	}
	#lb-prev::after { transform: rotate(-135deg) translateX(-1px); }
	#lb-next::after { transform: rotate(45deg) translateX(-1px); }

	#lb-close:hover,
	#lb-prev:hover,
	#lb-next:hover { background: rgba(255, 255, 255, 0.2); }

	#lb-prev[hidden],
	#lb-next[hidden] { display: none; }

	#lb-counter {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.55);
		letter-spacing: 0.04em;
		pointer-events: none;
	}
</style>
