---
import { Briefcase01Icon, HugeiconsIcon } from '@icons';
import SectionLink from '@/components/ui/SectionLink';
import { type Experience, experience } from '@/data/experience';

interface Props {
	featuredOnly?: boolean;
	includeTypes?: Experience['employmentType'][];
	excludeTypes?: Experience['employmentType'][];
}

const { featuredOnly = false, includeTypes, excludeTypes } = Astro.props;

let items = featuredOnly
	? experience.filter((entry) => entry.featured !== false).slice(0, 6)
	: experience;

if (includeTypes) items = items.filter((entry) => includeTypes.includes(entry.employmentType));
if (excludeTypes) items = items.filter((entry) => !excludeTypes.includes(entry.employmentType));
---

<div class="flex flex-col">
	{
		items.map((entry, index) => {
			const isLast = index === items.length - 1;
			const period = `${entry.startDate} - ${entry.endDate}`;

			return (
				<div
					class:list={[
						'flex items-start gap-3 py-3.5',
						!isLast && 'border-b border-[var(--border)]',
					]}
					data-scroll-animate
					data-index={Math.min(index, 5)}
				>
					{/* Logo */}
					<div class="shrink-0 pt-px">
						{entry.logo ? (
							<>
								<img
									src={entry.logo}
									alt={entry.company}
									width="28"
									height="28"
									class:list={[
										'h-7 w-7 rounded-[6px] object-contain',
										entry.logoInvert ? 'invert dark:invert-0' : '',
									]}
									onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
								/>
								<div class="hidden h-7 w-7 items-center justify-center rounded-[6px] text-[var(--text-ghost)]">
									<HugeiconsIcon icon={Briefcase01Icon} size={16} />
								</div>
							</>
						) : (
							<div class="flex h-7 w-7 items-center justify-center rounded-[6px] text-[var(--text-ghost)]">
								<HugeiconsIcon icon={Briefcase01Icon} size={16} />
							</div>
						)}
					</div>

					{/* Company · role + period, then a single description line */}
					<div class="min-w-0 flex-1">
						<div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
							{entry.website ? (
								<a
									href={entry.website}
									target={entry.website.startsWith('http') ? '_blank' : undefined}
									rel={entry.website.startsWith('http') ? 'noopener noreferrer' : undefined}
									class="font-semibold text-[13px] text-[var(--text-secondary)] tracking-[-0.01em] no-underline transition-colors duration-150 hover:text-[var(--text-primary)]"
								>
									{entry.company}
								</a>
							) : (
								<span class="font-semibold text-[13px] text-[var(--text-secondary)] tracking-[-0.01em]">
									{entry.company}
								</span>
							)}
							<span class="text-[12px] text-[var(--text-muted)]">· {entry.role}</span>
							<span class="ml-auto whitespace-nowrap text-[11px] text-[var(--text-ghost)] tabular-nums">
								{period}
							</span>
						</div>

						{entry.description && (
							<p class="m-0 mt-0.5 text-[12px] text-[var(--text-ghost)] leading-[1.6]">
								{entry.description}
							</p>
						)}
					</div>
				</div>
			);
		})
	}
</div>

{
	featuredOnly && (
		<div class="mt-3 flex justify-end">
			<SectionLink href="/resume" label="Full resume" />
		</div>
	)
}

<script>
	import { onPage } from '@/lib/lifecycle';

	onPage(() => {
		const items = document.querySelectorAll<HTMLElement>('[data-scroll-animate]');
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						const el = entry.target as HTMLElement;
						const idx = parseInt(el.dataset.index ?? '0', 10);
						el.style.animationDelay = `${idx * 0.04}s`;
						el.classList.add('animate-fade-in-up');
						observer.unobserve(el);
					}
				}
			},
			{ rootMargin: '-40px 0px' },
		);
		for (const item of items) observer.observe(item);
		return () => observer.disconnect();
	});
</script>
