{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.astro"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"style": {
				"noUnusedTemplateLiteral": "warn",
				"useTemplate": "warn",
				"noInlineStyles": "warn"
			},
			"suspicious": {
				"noConsole": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSameLine": false
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/map.tsx"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		},
		{
			"includes": ["src/components/experiments/holo-card/**"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		},
		{
			"includes": [
				"src/components/experiments/gaia-ui/chat-demo.tsx",
				"src/components/experiments/gaia-ui/iphone-mockup.tsx",
				"src/components/experiments/gaia-ui/footer-glow.tsx",
				"src/components/experiments/gaia-ui/footer-wordmark.tsx",
				"src/components/experiments/gaia-ui/grain-overlay.tsx",
				"src/components/home/VinylDisk.tsx"
			],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		}
	],
	"tailwind": {
		"attributes": ["class", "className"],
		"mergeFunctions": ["cn", "clsx", "cx", "twMerge", "twJoin"],
		"variantFunctions": ["cva"]
	}
}
