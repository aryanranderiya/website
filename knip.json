{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts,tsx}",
    "src/layouts/**/*.astro",
    "astro.config.*",
    "src/components/ui/AIChat.tsx",
    "src/bones/registry.js",
    "src/data/ai-context.ts"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx,js,jsx}"
  ],
  "ignore": [
    "src/env.d.ts",
    ".astro/**"
  ],
  "ignoreDependencies": [
    "@astrojs/check",
    "sharp",
    "tailwindcss",
    "tw-animate-css",
    "cloudflare",
    "@lhci/cli",
    "lighthouse",
    "@playwright/test",
    "playwright"
  ]
}
