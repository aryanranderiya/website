{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts,tsx}",
    "src/layouts/**/*.astro",
    "astro.config.*",
    "src/components/ui/AIChat.tsx",
    "src/bones/registry.js",
    "src/data/ai-context.ts"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx,js,jsx}"
  ],
  // Data-contract types (e.g. GaiaUiVariant, Sticker) are referenced by other
  // exported types in the same file. Knip only counts cross-file usage, so
  // without this it reports live model types as unused.
  "ignoreExportsUsedInFile": true,
  // System binaries (brew-installed, not npm): cloudflared for the Spotify
  // re-auth tunnel, ffprobe for media validation.
  "ignoreBinaries": ["cloudflared", "ffprobe"],
  "ignore": [
    "src/env.d.ts",
    ".astro/**"
  ],
  "ignoreDependencies": [
    "@astrojs/check",
    "sharp",
    "tailwindcss",
    "tw-animate-css",
    "cloudflare",
    "@lhci/cli",
    "lighthouse",
    "@playwright/test",
    "playwright"
  ]
}
